# SpectraFlow Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Local Audio Streaming Server Port (default: 8888)
SPECTRAFLOW_PORT=8888

# Optional custom directory for local audio indexing and vault caching
# Default: User standard Music/SpectraFlow directory
SPECTRAFLOW_MUSIC_DIR=

# Synchronized Lyrics API endpoint (default: https://lrclib.net)
LRCLIB_INSTANCE_URL=https://lrclib.net
