<?xml version="1.0" encoding="utf-8"?>
<!--
  System splash icon (Android 12+).
  Intentionally a solid black square so the launcher icon is *not* shown
  during cold start — we want the user to perceive a single continuous
  splash that begins with pure black and is then taken over by the Flutter
  beam-reveal animation.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/black" />
    <size android:width="1dp" android:height="1dp" />
</shape>
